OPENAI_API_KEY=
DART_API_KEY=
KRX_API_KEY=

LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

SEED_COMPANY=SK하이닉스
SEED_STOCK_CODE=000660

MAX_COMPANIES=20
MAX_DISCOVERY_HOPS=2
MAX_ANALYSIS_HOPS=3
MAX_BRANCHES_PER_HOP=3
MAX_DISCOVERY_PER_NODE=5
MAX_RETRIEVAL_CALLS=20
MAX_LLM_CALLS=25

CHUNK_SIZE=600
CHUNK_OVERLAP=80
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_TOP_K=5
MAX_MAJOR_DISCLOSURES=10
# 반기·분기보고서 수집 여부 (기본 false: 사업보고서만. 분기보고서는 경영진단·계열회사 항목이 생략되는 경우가 많음)
COLLECT_INTERIM_REPORTS=false

DATA_DIR=./data
LOG_LEVEL=INFO

# Korea Stock MCP 실행 명령 (korea-stock-mcp@1.4.1 고정, 설치: uv run python -m scripts.check_environment --install-mcp)
# npx -y korea-stock-mcp@1.4.1 도 사용할 수 있으나, 패키지 shebang 문제로 Linux에서는 실패한다.
MCP_COMMAND=node
MCP_ARGS=.mcp/node_modules/korea-stock-mcp/dist/index.js
